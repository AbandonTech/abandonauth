# `go test -race` links ThreadSanitizer, a C library, and requires a compiler to link it with.
FROM golang:1.27

WORKDIR /repo/src/api

COPY src/api/go.mod src/api/go.sum ./
RUN go mod download

COPY src/api/ ./
COPY scripts/ /repo/scripts/
COPY .env.sample /repo/.env.sample

# Tool versions come from the tool directives in go.mod.
RUN go tool sqlc generate && \
    go tool swag init \
        --v3.1 \
        --generalInfo cmd/abandonauth.go \
        --dir . \
        --output docs \
        --outputTypes go,json \
        --parseDependency=false \
        --quiet

# Each check runs in a fresh container, so without this the race-instrumented
# dependency tree is rebuilt on every pass, costing minutes per run. These are
# the tag sets containercheck.sh executes. -run NONE matches no test, so nothing
# is executed here.
RUN go test -race -count=1 -run NONE -tags=integration ./... && \
    go test -race -count=1 -run NONE -tags='integration devtools' ./...

CMD ["sh", "/repo/scripts/containercheck.sh"]
