{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./**/.env)",
      "Read(./**/.env.local)",
      "Read(./**/.env.development)",
      "Read(./**/.env.test)",
      "Read(./**/.env.staging)",
      "Read(./**/.env.production)",
      "Read(./**/.env.dev)",
      "Read(./**/.env.prod)",
      "Read(./**/.env.qa)",
      "Read(./**/.env.uat)",
      "Read(./**/.env.ci)",
      "Read(./**/.env.backup)",
      "Read(./**/.env.bak)",
      "Read(./**/.env.old)",
      "Read(./**/.env.save)",
      "Read(./**/*.key)",
      "Read(./**/*.pem)",
      "Read(./**/*.p12)",
      "Read(./**/*.pfx)"
    ]
  }
}
