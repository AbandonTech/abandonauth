POSTGRES_DB=postgres
POSTGRES_HOST=localhost
POSTGRES_PASSWORD=postgres
POSTGRES_USER=postgres
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}/${POSTGRES_DB}"

BIND_ADDRESS=0.0.0.0:8000
TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# Password sign-in and the API documentation need this, and so does serving the
# plain HTTP addresses below. Only a build carrying the development tooling
# accepts it; a deployment build refuses to start with it set.
DEBUG=true

# At least 64 bytes. Every signing key is derived from it, and replacing it
# invalidates every issued credential, so a deployment stores its own in a
# secret manager and runs `abandonauth database rotate-auth-epoch` after a
# change.
JWT_SECRET=replace-this-with-at-least-sixty-four-bytes-of-randomness-xxxxxxxxx
JWT_HASHING_ALGO=HS512
JWT_EXPIRES_IN_SECONDS_LONG_LIVED=2592000
JWT_EXPIRES_IN_SECONDS_SHORT_LIVED=120

ABANDON_AUTH_URL=http://localhost:8000
ABANDON_AUTH_SITE_URL=http://localhost:3000
ABANDON_AUTH_DEVELOPER_APP_ID=

# A sign-in starts at the site, which is where the cookie binding it to this
# browser is set, so the provider must return the browser to the site rather
# than to the API's own address. A deployment serves both from one origin.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
ABANDON_AUTH_DISCORD_CALLBACK=http://localhost:3000/api/ui/discord-callback

GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
ABANDON_AUTH_GITHUB_CALLBACK=http://localhost:3000/api/ui/github-callback

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK=http://localhost:3000/api/google
